{
  "name": "touchmyapi",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "dev:api": "bun --cwd apps/api dev",
    "dev:admin-api": "bun --cwd apps/api dev:admin",
    "dev:web": "bun --cwd apps/web dev",
    "dev:admin": "bun --cwd apps/admin dev",
    "dev:local": "bun scripts/dev-local.ts",
    "local:smoke": "bun scripts/local-smoke.ts",
    "local:up": "docker compose --profile local -f infra/docker/compose.yml up -d postgres",
    "local:down": "docker compose --profile local -f infra/docker/compose.yml down",
    "local:logs": "docker compose --profile local -f infra/docker/compose.yml logs -f --tail=100 postgres",
    "typecheck": "bun x tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:isolation": "vitest run --project isolation",
    "test:e2e": "RUN_LOCAL_E2E=1 vitest run --project e2e",
    "db:migrate": "bun packages/db/scripts/migrate.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --check . --ignore-unknown",
    "format:write": "prettier --write . --ignore-unknown",
    "prepare": "husky",
    "verify:workspace": "bun scripts/verify-workspace.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
