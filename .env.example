# TouchMyAPI local development environment.
# Copy to .env and fill in real values. Never commit .env.

# API server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (local development only; see infra/docker/compose.yml)
# Local Compose may use its documented development default when this is empty.
POSTGRES_PASSWORD=
# Example only (set this in .env or the shell before running db:migrate):
DATABASE_URL=
AUTH_DATABASE_URL=
API_DATABASE_URL=
AUDIT_DATABASE_URL=
QUEUE_DATABASE_URL=
WORKER_DATABASE_URL=
REPORTING_DATABASE_URL=
# Production uses distinct high-entropy connector passwords in these URLs.
# deploy-ovh configures only the fixed least-privilege connector identities
# after migrations; do not reuse POSTGRES_PASSWORD.
RUN_DB_TESTS=0

# Customer OAuth — GitHub Authorization Code + PKCE
# Local combined development overrides this with its explicit mock composition.
# Production: use disabled until the OAuth App exists, then github. Never mock.
AUTH_PROVIDER=mock
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback
WEB_APP_ORIGIN=http://localhost:5173
AUTH_TRANSIENT_KEY=
AUTH_SESSION_MAX_AGE_SECONDS=86400
AUTH_TRANSIENT_MAX_AGE_SECONDS=600

# Deferred Google provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (test mode only; never commit live keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_LIFETIME=

# Production runner stays disabled until the isolated adapter is reviewed.
# Private S3-compatible storage is used locally and by eligible report downloads.
SANDBOX_IMPL=noop
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=auto

# Web client (public by definition — anything prefixed VITE_ is public)
VITE_API_BASE_URL=http://localhost:3000
# OAuth client IDs and Stripe publishable keys are safe for the browser; never
# place a client secret, Stripe secret key, webhook secret, or storage key here.
VITE_GOOGLE_CLIENT_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
